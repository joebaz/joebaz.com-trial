---
import "../styles/global.css";
import { language, siteName } from "virtual:website-facts";

interface Props {
  title: string;
  description: string;
  /** `src` is a `public/` path, an imported image's `src`, or an absolute URL. */
  image?: { src: string; alt: string };
}

const { title, description, image } = Astro.props;

// The site name, language, and production URL (`Astro.site`) come from
// website-facts.yaml; the layout omits tags that need an undecided fact.
// Canonical and social URLs need the production URL. File-format builds
// report paths such as `/about.html`, and `/index.html` for the homepage;
// canonical paths drop trailing slashes and `.html`.
const pagePath = Astro.url.pathname.replace(/\/+$/, "").replace(/\.html$/, "");
const canonicalPath = pagePath === "" || pagePath === "/index" ? "/" : pagePath;
const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : undefined;
const socialImage =
  image && URL.canParse(image.src, Astro.site)
    ? { url: new URL(image.src, Astro.site).href, alt: image.alt }
    : undefined;
---

<!doctype html>
<html lang={language ?? undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteName ? `${title} | ${siteName}` : title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage.url} />
        <meta property="og:image:alt" content={socialImage.alt} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
  </head>
  <body class="bg-white text-slate-950">
    <slot />
  </body>
</html>
